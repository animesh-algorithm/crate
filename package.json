{
  "name": "crate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@10.9.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project crate-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run test:rules && npm run build",
    "test:model": "CRATE_MODEL_TEST=1 CRATE_PRODUCTION_TEST=1 playwright test --grep \"pinned model\""
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@huggingface/transformers": "^4.3.0",
    "dexie": "^4.2.0",
    "firebase": "^12.19.0",
    "franc-min": "^6.2.0",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "lucide-react": "^0.468.0",
    "minisearch": "^7.2.0",
    "motion": "^12.43.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.0",
    "firebase-tools": "^15.30.2",
    "prettier": "^3.9.8",
    "typescript": "^5.9.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
