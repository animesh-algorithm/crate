rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    function admissionOpen() {
      return exists(/databases/$(database)/documents/config/release)
        && get(/databases/$(database)/documents/config/release).data.accepting == true;
    }
    function manifestPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/library/manifest;
    }
    function established(userId) {
      return exists(manifestPath(userId));
    }
    function validManifest(data, userId) {
      return data.keys().hasOnly(['revision', 'snapshotId', 'updatedAt'])
        && data.revision is int && data.revision > 0
        && data.snapshotId is string && data.snapshotId.size() > 0 && data.snapshotId.size() <= 64
        && data.updatedAt is timestamp
        && exists(/databases/$(database)/documents/users/$(userId)/library/manifest/snapshots/$(data.snapshotId));
    }
    function validSnapshot(data) {
      return data.keys().hasOnly(['chunkCount', 'createdAt'])
        && data.chunkCount is int && data.chunkCount > 0 && data.chunkCount <= 128
        && data.createdAt is timestamp;
    }
    function validChunk(data, snapshotId, chunkId, userId) {
      let parent = get(/databases/$(database)/documents/users/$(userId)/library/manifest/snapshots/$(snapshotId));
      return data.keys().hasOnly(['index', 'data'])
        && data.index is int && data.index >= 0 && data.index < parent.data.chunkCount
        && chunkId == string(data.index)
        && data.data is string && data.data.size() > 0 && data.data.size() <= 240000;
    }
    match /config/release {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /users/{userId}/library/manifest {
      allow read, delete: if signedInOwner(userId);
      allow create: if signedInOwner(userId) && admissionOpen()
        && validManifest(request.resource.data, userId);
      allow update: if signedInOwner(userId)
        && validManifest(request.resource.data, userId)
        && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{userId}/library/manifest/snapshots/{snapshotId} {
      allow read, delete: if signedInOwner(userId);
      allow create: if signedInOwner(userId) && (admissionOpen() || established(userId))
        && validSnapshot(request.resource.data);
    }
    match /users/{userId}/library/manifest/snapshots/{snapshotId}/chunks/{chunkId} {
      allow read, delete: if signedInOwner(userId);
      allow create: if signedInOwner(userId)
        && exists(/databases/$(database)/documents/users/$(userId)/library/manifest/snapshots/$(snapshotId))
        && validChunk(request.resource.data, snapshotId, chunkId, userId);
    }
  }
}
