rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/release {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /users/{userId}/library/manifest {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && get(/databases/$(database)/documents/config/release).data.accepting == true;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/library/manifest/snapshots/{snapshotId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && get(/databases/$(database)/documents/config/release).data.accepting == true;
    }
    match /users/{userId}/library/manifest/snapshots/{snapshotId}/{document=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && get(/databases/$(database)/documents/config/release).data.accepting == true;
    }
  }
}
